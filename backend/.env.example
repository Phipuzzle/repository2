APP_NAME=Intelligent Data Agent API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://ida:ida@localhost:5432/intelligent_data_agent
CORS_ORIGINS=["http://localhost:3000","http://localhost:3002"]
QUERY_DEFAULT_LIMIT=100
QUERY_MAX_LIMIT=1000
QUERY_TIMEOUT_SECONDS=15
QUERY_CACHE_TTL_SECONDS=300
DEMO_SCALE=20
DEMO_YEARS=5
SSE_POLL_INTERVAL_SECONDS=0.5
SSE_HEARTBEAT_SECONDS=15
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=4096
AGENT_ENABLED=true
AGENT_DEMO_ANONYMOUS_READ=false
COST_APPROVAL_THRESHOLD=100000
OIDC_ISSUER=http://localhost:8080/realms/ida
OIDC_AUDIENCE=intelligent-data-agent-api
OIDC_JWKS_URL=http://localhost:8080/realms/ida/protocol/openid-connect/certs
OIDC_ALGORITHMS=["RS256"]
OIDC_JWKS_CACHE_SECONDS=300
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL_ID=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_MODEL_SOURCE=huggingface
METADATA_RETRIEVAL_TOP_K=8
SLO_LOOKBACK_MINUTES=1440
SLO_AGENT_P95_SECONDS=30.0
SLO_AGENT_ERROR_RATE=0.2
SLO_DEEPSEEK_P95_SECONDS=20.0
SLO_DEEPSEEK_ERROR_RATE=0.2
ALERT_WEBHOOK_URL=
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
